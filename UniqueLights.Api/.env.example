# Copy to .env (same folder) for local development. .env is git-ignored and loaded at startup;
# real environment variables always take precedence. Never commit real secrets.

# Supabase: Project Settings -> Database -> Connection string (use the Session pooler, port 5432)
ConnectionStrings__DefaultConnection=Host=aws-0-ap-south-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.your-project-ref;Password=your-db-password;SSL Mode=Require;Trust Server Certificate=true

# At least 32 characters. Generate e.g. with: openssl rand -base64 48
Jwt__Secret=replace-with-a-long-random-secret-of-at-least-32-characters
Jwt__Issuer=UniqueLights
Jwt__Audience=UniqueLights.Web

# Supabase: Project Settings -> API Keys. Use a secret key (sb_secret_...) or the legacy service_role key; server-side only.
Supabase__Url=https://your-project-ref.supabase.co
Supabase__ServiceKey=your-service-role-key
Supabase__Bucket=product-images

# Admin user is created by the seeder only when both values are set.
Seed__AdminEmail=admin@example.com
Seed__AdminPassword=ChangeMe123

Cors__AllowedOrigins__0=http://localhost:5173
